{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "test": {
      "inputs": ["src/**/*.spec.ts", "test/**/*.spec.ts"]
    },
    "test:e2e": {
      "inputs": ["test/**/*.e2e-spec.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "JWT_SECRET",
        "DB_TYPE",
        "DB_HOST",
        "DB_PORT",
        "DB_USERNAME",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_DATABASE",
        "DB_SYNCHRONIZE",
        "REDIS_HOST",
        "REDIS_PORT",
        "REDIS_USERNAME",
        "REDIS_PASSWORD",
        "REDIS_DB",
        "PORT",
        "LOG_LEVEL",
        "VITE_API_URL"
      ]
    }
  }
}
